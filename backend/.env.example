# Copy to .env and adjust. Never commit the real file.

# --- Database -------------------------------------------------------------
# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./restaurant.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/restaurant

# --- Business -------------------------------------------------------------
BUSINESS_NAME=Restoran Suriani
CURRENCY=RM
CORS_ORIGINS=["http://localhost:3000"]

# --- Authentication -------------------------------------------------------
# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it unset and a new one is made each start, which logs everyone out on
# every restart. Set it anywhere this is deployed.
SECRET_KEY=

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this exact
# redirect URI to it. Until both values are set the app runs with no accounts
# at all and every endpoint is open - fine on a laptop, not on a network.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Where the browser is sent after signing in.
FRONTEND_URL=http://localhost:3000

# The shop tablet should not meet a login screen day to day.
SESSION_DAYS=90
# Accountant Mode re-locks itself well before the session expires.
UNLOCK_HOURS=8

# Turn this on once the app is served over https.
COOKIE_SECURE=false

# These addresses get OWNER on first sign-in; everyone else starts as STAFF.
# Otherwise the very first person to sign in becomes the owner.
OWNER_EMAILS=[]
ACCOUNTANT_EMAILS=[]
# When set, nobody outside this list can sign in at all.
ALLOWED_EMAILS=[]

# PIN lockout, which is what actually protects a 4-6 digit PIN.
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
